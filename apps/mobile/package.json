    "@personalspace/ui": "workspace:*",
    "@personalspace/validation": "workspace:*",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "expo": "~57.0.26",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
