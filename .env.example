NODE_ENV=development
PORT=4000
HOST=127.0.0.1
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://personalspace_app:local_app_only@localhost:5432/personalspace
AUTH_DATABASE_URL=postgresql://personalspace_auth:local_auth_only@localhost:5432/personalspace
WORKER_DATABASE_URL=postgresql://personalspace_worker:local_worker_only@localhost:5432/personalspace
MAINTENANCE_DATABASE_URL=postgresql://personalspace_maintenance:local_maintenance_only@localhost:5432/personalspace
MIGRATION_DATABASE_URL=postgresql://postgres:local_owner_only@localhost:5432/personalspace
REDIS_URL=redis://localhost:6379
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# On a real device set this to your computer's LAN IP, and HOST=0.0.0.0 above.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional private attachment storage (development only): enable the attachments Compose profile.
# Leave this group unset to keep file endpoints disabled; text sync still works.
# S3_BUCKET=personalspace-attachments
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=local_storage_only
# S3_SECRET_ACCESS_KEY=local_storage_password_only
# S3_FORCE_PATH_STYLE=true
# Android emulator upload URLs need S3_PUBLIC_ENDPOINT=http://10.0.2.2:9000.

# Optional attachment processor: provision the restricted role's login/password first.
# Use a private, current ClamAV daemon; see docs/attachments.md for required limits.
# ATTACHMENT_DATABASE_URL=postgresql://personalspace_attachment_processor:CHANGE_ME@localhost:5432/personalspace
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
